# Server Configuration
PORT=3000
CLIENT_URL=*

# JWT Authentication
JWT_SECRET=blotter-default-jwt-secret-key-2026
JWT_EXPIRES_IN=24h

# Database Configuration (Optional: runs in-memory mock if offline)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=blotter_db

# File Uploads
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
